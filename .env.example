# Copy to .env (local) or add in Vercel → Settings → Environment Variables.
# Never commit real values.

# Postgres connection (added automatically by Vercel's Neon integration)
DATABASE_URL=postgres://user:password@host:5432/dbname

# First admin, created only while there is no admin yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Optional: 32+ random characters used to sign sessions
AUTH_SECRET=

# Groq API key for the AI summary (server only — never exposed to the browser)
GROQ_API_KEY=your-groq-api-key
# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Per-request timeout in ms (default 25000)
GROQ_TIMEOUT_MS=
